rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isBuilder() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'builder') ||
        ('builder' in request.auth.token && request.auth.token.builder == true) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email.matches('.*@towerpulse\\.dev$') ||
          request.auth.token.email.matches('.*@builder\\.com$')
        ))
      );
    }

    function isNum(val) {
      return val is int || val is float;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidBuyer(data) {
      return data.keys().hasAll([
        'id', 'name', 'phone', 'tower', 'unit', 'configuration',
        'progressPercent', 'possessionDate', 'inviteCode', 'inviteStatus',
        'inviteExpiresAt', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'name', 'phone', 'tower', 'unit', 'configuration',
        'progressPercent', 'possessionDate', 'inviteCode', 'inviteStatus',
        'inviteExpiresAt', 'joinedAt', 'createdAt'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 50 &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
      data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25 &&
      data.tower is string && data.tower.size() >= 1 && data.tower.size() <= 50 &&
      data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30 &&
      data.configuration is string && data.configuration.size() >= 1 && data.configuration.size() <= 100 &&
      isNum(data.progressPercent) && data.progressPercent >= 0 && data.progressPercent <= 100 &&
      data.possessionDate is string && data.possessionDate.size() >= 10 && data.possessionDate.size() <= 30 &&
      data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 20 &&
      data.inviteStatus in ['pending', 'joined', 'expired'] &&
      isNum(data.inviteExpiresAt) && data.inviteExpiresAt > 0 &&
      isNum(data.createdAt) && data.createdAt > 0 &&
      (!('joinedAt' in data) || data.joinedAt == null || (isNum(data.joinedAt) && data.joinedAt > 0));
    }

    function isClaimingInviteCode(buyerId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteStatus', 'joinedAt']) &&
             resource.data.inviteStatus == 'pending' &&
             request.resource.data.inviteStatus == 'joined' &&
             'joinedAt' in request.resource.data &&
             request.resource.data.joinedAt != null &&
             isNum(request.resource.data.joinedAt) &&
             request.resource.data.joinedAt > 0 &&
             resource.data.inviteExpiresAt > request.time.toMillis() &&
             request.resource.data.id == buyerId &&
             isValidBuyer(request.resource.data);
    }

    function isValidNotice(data) {
      return data.keys().hasAll([
        'id', 'title', 'content', 'category', 'targetType',
        'targetTowers', 'targetUnits', 'audience', 'isPinned',
        'readCount', 'totalTargetBuyers', 'createdAt', 'createdBy', 'authorRole'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'content', 'category', 'targetType',
        'targetTowers', 'targetUnits', 'audience', 'isPinned',
        'readCount', 'totalTargetBuyers', 'createdAt', 'createdBy', 'authorRole', 'imageUrl'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 100 &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
      data.content is string && data.content.size() >= 1 && data.content.size() <= 5000 &&
      data.category in ['construction', 'milestone', 'maintenance', 'legal', 'payment', 'event', 'urgent'] &&
      data.targetType in ['all', 'towers', 'units'] &&
      data.targetTowers is list && data.targetTowers.size() <= 20 &&
      data.targetUnits is list && data.targetUnits.size() <= 200 &&
      data.audience is list && data.audience.size() >= 1 && data.audience.size() <= 200 &&
      data.isPinned is bool &&
      isNum(data.readCount) && data.readCount >= 0 &&
      isNum(data.totalTargetBuyers) && data.totalTargetBuyers >= 0 &&
      isNum(data.createdAt) && data.createdAt > 0 &&
      data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 100 &&
      data.authorRole is string && data.authorRole.size() >= 1 && data.authorRole.size() <= 100 &&
      (!('imageUrl' in data) || data.imageUrl == null || (
        data.imageUrl is string &&
        data.imageUrl.size() <= 1000 &&
        (data.imageUrl.matches('^https?://.*') || data.imageUrl == '')
      ));
    }

    function isValidNoticeReadCountIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount']) &&
             isNum(request.resource.data.readCount) &&
             request.resource.data.readCount == resource.data.readCount + 1 &&
             isValidNotice(request.resource.data);
    }

    function isValidReadReceipt(data) {
      return data.keys().hasAll(['buyerId', 'buyerName', 'unit', 'tower', 'phone', 'readAt']) &&
             data.keys().hasOnly(['buyerId', 'buyerName', 'unit', 'tower', 'phone', 'readAt']) &&
             data.buyerId is string && data.buyerId.size() >= 1 && data.buyerId.size() <= 50 &&
             data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 100 &&
             data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30 &&
             data.tower is string && data.tower.size() >= 1 && data.tower.size() <= 50 &&
             data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25 &&
             isNum(data.readAt) && data.readAt > 0;
    }

    match /buyers/{buyerId} {
      allow get: if isBuilder() || isAuthenticated() || (resource.data.inviteCode is string);
      allow list: if isBuilder() || isAuthenticated() || (resource.data.inviteCode is string);
      allow create: if isBuilder() &&
                       isValidBuyer(request.resource.data) &&
                       request.resource.data.id == buyerId;
      allow update: if (isBuilder() &&
                        isValidBuyer(request.resource.data) &&
                        areImmutableFieldsUnchanged(['id', 'createdAt'])) ||
                       isClaimingInviteCode(buyerId);
      allow delete: if isBuilder();
    }

    match /notices/{noticeId} {
      allow get, list: if isBuilder() || isAuthenticated() || (resource.data.audience is list);
      allow create: if isBuilder() &&
                       isValidNotice(request.resource.data) &&
                       request.resource.data.id == noticeId;
      allow update: if (isBuilder() &&
                        isValidNotice(request.resource.data) &&
                        areImmutableFieldsUnchanged(['id', 'createdAt', 'createdBy'])) ||
                       isValidNoticeReadCountIncrement();
      allow delete: if isBuilder();

      match /reads/{buyerId} {
        allow get: if isBuilder() || (resource.data.buyerId == buyerId);
        allow list: if isBuilder();
        allow create: if isValidReadReceipt(request.resource.data) &&
                         request.resource.data.buyerId == buyerId &&
                         exists(/databases/$(database)/documents/notices/$(noticeId));
        allow update, delete: if false;
      }
    }
  }
}
